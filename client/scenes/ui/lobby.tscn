[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/lobby.gd" id="1_script"]

[node name="Lobby" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.08, 0.08, 0.12, 1.0)

[node name="VBoxContainer" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = 20.0
offset_right = -40.0
offset_bottom = -20.0

[node name="Title" type="Label" parent="VBoxContainer"]
text = "Game Lobbies"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 38
theme_override_colors/font_color = Color(0.9, 0.4, 0.2, 1.0)

[node name="Spacer" type="Control" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 20)

[node name="ButtonRow" type="HBoxContainer" parent="VBoxContainer"]

[node name="CreateButton" type="Button" parent="VBoxContainer/ButtonRow"]
text = "Create Room"
theme_override_font_sizes/font_size = 20

[node name="RefreshButton" type="Button" parent="VBoxContainer/ButtonRow"]
text = "Refresh"
theme_override_font_sizes/font_size = 20

[node name="BackButton" type="Button" parent="VBoxContainer/ButtonRow"]

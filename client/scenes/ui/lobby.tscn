theme_override_font_sizes/font_size = 18

[node name="JoinButton" type="Button" parent="VBoxContainer/JoinRow"]
text = "Join"
theme_override_font_sizes/font_size = 20

[node name="StatusLabel" type="Label" parent="VBoxContainer"]
unique_name_in_owner = true
text = "Loading..."
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.6, 0.6, 0.7, 1.0)

[node name="CreatePopup" type="PopupPanel" parent="."]
unique_name_in_owner = true
size = Vector2i(400, 320)

[node name="VBoxContainer" type="VBoxContainer" parent="CreatePopup"]
anchors_preset = 15

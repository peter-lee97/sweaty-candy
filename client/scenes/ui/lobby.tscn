[node name="Spacer2" type="Control" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 14)

[node name="RoomTable" type="Tree" parent="VBoxContainer"]
unique_name_in_owner = true
columns = 4
size_flags_horizontal = 3
size_flags_vertical = 3
allow_reselect = true
theme_override_font_sizes/font_size = 18

[node name="JoinRow" type="HBoxContainer" parent="VBoxContainer"]

[node name="JoinLabel" type="Label" parent="VBoxContainer/JoinRow"]
text = "Password:"
theme_override_font_sizes/font_size = 18

[node name="JoinPasswordInput" type="LineEdit" parent="VBoxContainer/JoinRow"]
unique_name_in_owner = true

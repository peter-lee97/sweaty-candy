FROM node:22-alpine AS base
WORKDIR /app

FROM base AS build
COPY gameserver/package*.json ./gameserver/
RUN npm ci --omit=dev --prefix ./gameserver
COPY gameserver/src ./gameserver/src
COPY shared ./shared
COPY gameserver/package*.json ./gameserver/

FROM base AS prod
WORKDIR /app
COPY --from=build /app/gameserver/node_modules ./gameserver/node_modules
COPY --from=build /app/gameserver/src ./gameserver/src
COPY --from=build /app/shared ./shared
COPY --from=build /app/gameserver/package*.json ./gameserver/
ENV NODE_ENV=production
ENV BACKEND_BASE_URL=http://backend:8787
ENV LISTEN_HOST=0.0.0.0
ENV LISTEN_PORT=7777
EXPOSE 7777
CMD ["node", "gameserver/src/server.js"]